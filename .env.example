# Supabase project settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Meta pixel ID (Events Manager -> Data Sources). Leave blank to disable the pixel.
VITE_META_PIXEL_ID=994194000299509

# Instagram long-lived token (server-side only - no VITE_ prefix, never ships to the browser).
# Meta app -> Instagram -> API setup with Instagram login -> generate token (instagram_business_basic).
# Expires in 60 days; refresh via graph.instagram.com/refresh_access_token. Blank = feed section hides itself.
IG_TOKEN=
